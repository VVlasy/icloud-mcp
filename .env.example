# ---------------------------------------------------------------- iCloud account
# Apple ID you sign in with. Create the app-specific password at https://account.apple.com
# (Sign-In and Security > App-Specific Passwords). Never use your real Apple ID password here.
ICLOUD_USERNAME=you@icloud.com
ICLOUD_APP_PASSWORD=xxxx-xxxx-xxxx-xxxx
# Address mail is sent from. Must be your iCloud address (or one of its aliases). Defaults to ICLOUD_USERNAME.
# Set this if your Apple ID is not an @icloud.com / @me.com address.
#ICLOUD_EMAIL_ADDRESS=you@icloud.com
ICLOUD_DISPLAY_NAME=Your Name
# Optional plain-text signature appended to everything the connector sends (\n = newline).
#EMAIL_SIGNATURE=Your Name\nhttps://example.com
DEFAULT_TIMEZONE=Europe/Berlin
# Calendar new events go to when the agent does not name one (default: 'Calendar' or 'Home', else the first calendar)
#DEFAULT_CALENDAR=Calendar
# CARDDAV_URL=https://contacts.icloud.com
# CARDDAV_USERNAME=          -> only if the CardDAV login name must differ from ICLOUD_USERNAME

# ---------------------------------------------------------------- this server
# Public HTTPS address your MCP clients (Claude, ChatGPT, Codex...) reach the server at. No trailing slash, no path.
MCP_PUBLIC_URL=https://icloud-mcp.example.com
# Password YOU type on the consent page when connecting a client. 12+ random characters. NOT your Apple password.
MCP_OWNER_PASSWORD=change-me-to-a-long-random-string
# Cloudflare Tunnel (optional): put the token in a separate file .tunnel.env as TUNNEL_TOKEN=... and use the "tunnel" profile.

# ---------------------------------------------------------------- safety switches
# READ_ONLY=true            -> no sending, moving, deleting, calendar changes or contact changes (drafts disabled too; wins over ALLOW_SEND)
# ALLOW_SEND=false          -> everything except sending; agents can still save drafts for you to review
# SEND_ALLOWLIST=@example.org,friend@example.com   -> only these addresses/domains may receive mail from the connector
# MAX_RECIPIENTS=25
# ENABLE_MAIL=true
# ENABLE_CALENDAR=true
# ENABLE_CONTACTS=true        -> contacts_search_contacts / contacts_get_contact plus contact create/update/delete when READ_ONLY=false (CardDAV, same app-specific password)
# ALLOW_PERMANENT_DELETE=false -> true lets mail be deleted from Trash (reminders_delete_reminder is always available: a reminder is easily recreated)
# --- Owner approval (prompt-injection defence) ---
# With ALLOW_SEND=true, mail_send_message / mail_reply_to_message / mail_forward_message only QUEUE the message. It is delivered only when the owner
# opens https://<your-host>/outbox, types MCP_OWNER_PASSWORD and presses Approve. Keep this true.
# SEND_REQUIRES_APPROVAL=true
# OUTBOX_TTL_SECONDS=86400    -> unapproved messages expire after this long and are never sent
# OUTBOX_MAX=20               -> max messages waiting for approval
# Calendar events with attendees make iCloud email people (invitations, updates, cancellations), which would bypass the gate.
# Blocked unless you opt in:
# ALLOW_CALENDAR_INVITES=false
# With invites on, the calendar is an outbound channel like mail (an invitation carries the event's text to every guest), so:
# INVITE_ALLOWLIST=@example.org,friend@example.com   -> only these addresses/domains may be invited or answered (empty = anyone)
# MAX_ATTENDEES=10          -> most guests one event may carry through the connector
# CONTACTS_ALLOW_EMAIL_CHANGES=true  -> false = agents cannot add or replace addresses or numbers on contact cards (a poisoned
#                              card would route a later genuine reply to a stranger); results and the approval page mark
#                              addresses an agent added either way
# MAIL_MAX_AGE_DAYS=0       -> 0 = whole mailbox; e.g. 90 = searches never reach further back than 90 days
# SAFETY_SCREEN=            -> empty = the built-in patterns; command:/path/to/program = your own classifier is run on every piece
#                              of third-party text (stdin in, JSON {"injection_suspected": true|false} out) and adds a warning

# ---------------------------------------------------------------- Reminders / Notes / iCloud Drive via a helper on your Mac (optional)
# Apple exposes these only through their Mac apps, so a small helper (see mac-helper/README.md) runs on your Mac and polls this server.
# The bridge has its own private HTTPS port, published only on the address in BRIDGE_BIND, never through a public tunnel.
# ENABLE_REMINDERS=false
# ENABLE_NOTES=false       -> notes: read, create, append, update, folders and move; edits are guarded and backed up; delete goes to Recently Deleted
# ENABLE_DRIVE=false       -> the whole iCloud Drive as synced on the Mac; nothing is ever deleted permanently (see README)
# ENABLE_MAPS=false        -> Apple Maps travel times and place search (MapKit on the Mac; no location access)
# ENABLE_IMESSAGE=false    -> read and search your own iMessage/SMS history (the Mac user's own Messages, read-only)
# ENABLE_HEALTH=false      -> daily Apple Health figures from your iPhone's Shortcut exports (see README)
# IMESSAGE_HIDDEN_CHATS=    -> chat ids (handles or group ids) never listed, read or searched, comma-separated
# IMESSAGE_VISIBLE_CHATS=   -> when set, ONLY these chats
# IMESSAGE_MAX_AGE_DAYS=0   -> 0 = the whole history; 365 = only the last year
# IMESSAGE_HIDE_SHORT_CODES=true -> hide service senders (banks, one-time codes): anything that is not an email or a full number
# IMESSAGE_NEVER_SEND=      -> handles nothing is ever sent to, e.g. your own assistant's Apple ID (its chat is labelled)
# IMESSAGE_ALLOW_SEND=false -> register imessage_send_message at all
# IMESSAGE_SEND_REQUIRES_APPROVAL=true -> every iMessage waits on /outbox for you (independent of SEND_REQUIRES_APPROVAL for mail)
# IMESSAGE_SEND_ALLOWLIST=  -> who may receive one: handles or chat ids; EMPTY = NOBODY, * = anyone
# SHORTCUTS_ALLOW=          -> exact Shortcut names the assistant may run (the Mac must list them too, in the helper's shortcuts-allow.txt)
# BRIDGE_TOKEN=             -> random secret, at least 32 characters: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
# BRIDGE_BIND=127.0.0.1     -> host address the bridge port is published on (docker compose). Set your LAN/VPN address for the Mac.
# BRIDGE_PORT=8001
# BRIDGE_HOST=127.0.0.1   -> address the bridge binds to inside the process. Loopback by default; the Docker image sets
#                             0.0.0.0 itself so compose can publish the port on BRIDGE_BIND. Set it only for a bare install
#                             whose helper Mac connects over the network.
# BRIDGE_JOB_TIMEOUT_SECONDS=60 -> how long a call waits for the Mac; capped at TOOL_TIMEOUT_SECONDS minus 5

# ---------------------------------------------------------------- iCloud behaviour
# The connector copies each sent message into the Sent folder itself. Run
#   python -m icloud_mcp.selftest --probe-sent you@icloud.com
# once. If it reports that iCloud already files sent mail by itself, set this to false to avoid duplicates.
SAVE_SENT_COPY=true

# ---------------------------------------------------------------- robustness
# MCP_STATELESS=true        -> no in-memory MCP sessions: restarting the server cannot invalidate a connected client
# TOOL_TIMEOUT_SECONDS=60   -> a tool call running longer is abandoned with an error naming the slow step (at most 90 with JSON responses)
# MCP_JSON_RESPONSE=true    -> one plain JSON body per request instead of an event stream (false if a client has trouble with it)
# MCP_STRUCTURED_CONTENT=false -> also send each result as structuredContent (otherwise sent once, as compact JSON text)
# IMAP_POOL_SIZE=3          -> logged-in mail connections kept for reuse (0 = log in for every call)
# IMAP_IDLE_SECONDS=600     -> kept connections are pinged every 5 minutes while used within this time, then closed
# CALDAV_POOL_SIZE=4        -> calendar connections kept for reuse
# CALDAV_KEEPALIVE_SECONDS=600 -> keep calendar connections warm this long after the last call (0 = off: reconnect after 15 s idle)
# WARMUP_ON_START=true      -> sign in to mail, calendar and contacts in the background right after start
# TOOL_WORKERS=8            -> tool calls that can run at the same time
# ADMIN_PORT=8002           -> admin API for the menu bar app (127.0.0.1 only, token in DATA_DIR/admin-token); off when unset
# OWNER_ADDRESSES=          -> more addresses that are yours (aliases), comma-separated, e.g. for invitations to an alias
# AGENT_NOTES_FILE=         -> your own rules for agents (a Markdown file on this machine, up to 8,000 characters), added to the
#                              instructions; example: docs/agent-notes.example.md. Never commit your real one, and keep it OUTSIDE
#                              iCloud Drive (agents may not write, move or trash it, and the Drive tools refuse the path, but a file
#                              outside the Drive is out of their reach altogether).

# ---------------------------------------------------------------- OAuth
# Redirect hosts clients may register. Add others (ChatGPT, Cursor, ...) if you connect them.
#OAUTH_ALLOWED_REDIRECT_HOSTS=claude.ai,claude.com,chatgpt.com,chat.openai.com,localhost,127.0.0.1
#ACCESS_TOKEN_TTL=3600
#REFRESH_TOKEN_TTL=2592000
